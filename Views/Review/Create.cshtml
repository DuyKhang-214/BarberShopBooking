@model BarberShopBooking.ViewModels.ReviewCreateViewModel

@{
    ViewData["Title"] = "Đánh giá dịch vụ & Barber";
}

<section class="review-page py-4">
    <div class="container" style="max-width: 600px;">
        <div class="card bg-dark text-white border-warning p-4 shadow">
            <h2 class="text-warning mb-4 text-center">Đánh giá dịch vụ & Barber</h2>

            <div class="bg-secondary p-3 rounded mb-4 text-black">
                <p class="mb-1"><strong>Barber:</strong> @Model.BarberName</p>
                <p class="mb-1"><strong>Dịch vụ:</strong> @Model.ServiceName</p>
                <p class="mb-0"><strong>Ngày làm việc:</strong> @Model.AppointmentDate.ToString("dd/MM/yyyy")</p>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AppointmentId" />
                <input type="hidden" asp-for="BarberId" />
                <input type="hidden" asp-for="BarberName" />
                <input type="hidden" asp-for="ServiceName" />
                <input type="hidden" asp-for="AppointmentDate" />

                <div class="form-group mb-4">
                    <label class="form-label d-block fw-bold fs-5 mb-2">Đánh giá số sao (1 đến 5)</label>
                    <div class="d-flex gap-3 fs-3 justify-content-center">
                        @for (int i = 5; i >= 1; i--)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" asp-for="Rating" id="star@i" value="@i">
                                <label class="form-check-label text-warning" for="star@i">@i ★</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Rating" class="text-danger d-block text-center"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Comment" class="form-label fw-bold"></label>
                    <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Hãy chia sẻ trải nghiệm cắt tóc của bạn với barber này..."></textarea>
                    <span asp-validation-for="Comment" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning w-100 py-2 fs-5">
                        <i class="fa-solid fa-paper-plane me-1"></i> Gửi đánh giá
                    </button>
                    <a asp-controller="Appointment" asp-action="MyAppointments" class="btn btn-outline-secondary w-100 py-2 fs-5">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}