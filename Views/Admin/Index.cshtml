@model BarberShopBooking.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Bảng điều khiển Admin";
}

<section class="admin-page py-4">
    <div class="container">
        <h1 class="mb-4 text-warning"><i class="fa-solid fa-gauge me-2"></i> Bảng điều khiển Quản trị (Dashboard)</h1>

        <!-- Stats Overview Cards -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card bg-dark text-white border-warning h-100 p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Doanh thu</h6>
                            <h3 class="text-warning mb-0">@Model.TotalRevenue.ToString("N0") đ</h3>
                        </div>
                        <i class="fa-solid fa-money-bill-wave fa-2x text-warning"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card bg-dark text-white border-warning h-100 p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Tổng lịch hẹn</h6>
                            <h3 class="text-white mb-0">@Model.TotalAppointments</h3>
                            <small class="text-warning">@Model.PendingAppointments chờ xác nhận</small>
                        </div>
                        <i class="fa-solid fa-calendar-check fa-2x text-warning"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card bg-dark text-white border-warning h-100 p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Khách hàng</h6>
                            <h3 class="text-white mb-0">@Model.TotalUsers</h3>
                        </div>
                        <i class="fa-solid fa-users fa-2x text-warning"></i>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card bg-dark text-white border-warning h-100 p-3 shadow-sm">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted text-uppercase mb-1">Đánh giá & Liên hệ</h6>
                            <h3 class="text-white mb-0">@Model.TotalReviews ★</h3>
                            <small class="text-warning">@Model.PendingContacts tin chờ trả lời</small>
                        </div>
                        <i class="fa-solid fa-comments fa-2x text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Navigation Grid -->
        <h2 class="h4 text-white mb-3">Danh mục quản lý</h2>
        <div class="row g-3 mb-5">
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminAppointment" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-calendar-days fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Quản lý Lịch hẹn</h5>
                    <p class="card-text text-muted small">Xác nhận, hoàn thành hoặc hủy lịch hẹn.</p>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminBarber" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-user-tie fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Quản lý Barber</h5>
                    <p class="card-text text-muted small">Thêm barber & cài đặt lịch làm việc tuần.</p>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminService" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-scissors fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Quản lý Dịch vụ</h5>
                    <p class="card-text text-muted small">Cập nhật giá tiền và thời lượng dịch vụ.</p>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminHairstyle" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-images fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Bộ sưu tập Kiểu tóc</h5>
                    <p class="card-text text-muted small">Đăng ảnh mẫu kiểu tóc mới nhất.</p>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminUser" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-user-shield fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Quản lý Tài khoản</h5>
                    <p class="card-text text-muted small">Phân quyền Admin & khóa tài khoản.</p>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminReview" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-star fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Quản lý Đánh giá</h5>
                    <p class="card-text text-muted small">Xem và xoá đánh giá không phù hợp.</p>
                </a>
            </div>

            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <a asp-controller="AdminContact" asp-action="Index" class="card bg-dark text-white border-secondary text-decoration-none h-100 p-3 admin-nav-card">
                    <i class="fa-solid fa-envelope-open-text fa-2x text-warning mb-2"></i>
                    <h5 class="card-title text-warning">Phản hồi Liên hệ</h5>
                    <p class="card-text text-muted small">Trả lời tin nhắn từ khách hàng.</p>
                </a>
            </div>
        </div>

        <!-- Recent Appointments Table -->
        <h2 class="h4 text-white mb-3">Lịch hẹn gần đây</h2>
        <div class="table-responsive bg-dark rounded p-3 border border-secondary">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Barber</th>
                        <th>Dịch vụ</th>
                        <th>Ngày & Giờ</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.RecentAppointments)
                    {
                        <tr>
                            <td>@appt.User?.FullName <br/><small class="text-muted">@@@appt.User?.Username</small></td>
                            <td>@appt.Barber?.FullName</td>
                            <td>@appt.Service?.ServiceName</td>
                            <td>@appt.AppointmentDate.ToString("dd/MM/yyyy") - @appt.AppointmentTime.ToString(@"hh\:mm")</td>
                            <td>
                                <span class="status-badge @appt.Status.ToCssClass()">
                                    @appt.Status.ToDisplayName()
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>