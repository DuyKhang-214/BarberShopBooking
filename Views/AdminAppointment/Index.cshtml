@model List<BarberShopBooking.Models.Appointment>

@{
    ViewData["Title"] = "Quản lý Lịch hẹn";
}

<section class="admin-page py-4">
    <div class="container">
        <h1 class="text-warning h3 mb-4"><i class="fa-solid fa-calendar-check me-2"></i> Quản lý Lịch hẹn hệ thống</h1>

        <div class="table-responsive bg-dark rounded p-3 border border-secondary">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Khách hàng</th>
                        <th>Dịch vụ</th>
                        <th>Barber</th>
                        <th>Ngày & Giờ đặt</th>
                        <th>Giá tiền</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th class="text-end">Cập nhật trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.User?.FullName</strong>
                                <br/><small class="text-muted">SĐT: @(item.User?.Phone ?? "N/A")</small>
                            </td>
                            <td class="text-warning font-weight-bold">@item.Service?.ServiceName</td>
                            <td>@item.Barber?.FullName</td>
                            <td>
                                @item.AppointmentDate.ToString("dd/MM/yyyy")
                                <br/><small class="badge bg-secondary">@item.AppointmentTime.ToString(@"hh\:mm")</small>
                            </td>
                            <td>@item.PriceAtBooking.ToString("N0") VNĐ</td>
                            <td>
                                <span class="status-badge @item.Status.ToCssClass()">
                                    @item.Status.ToDisplayName()
                                </span>
                            </td>
                            <td><small class="text-muted">@(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)</small></td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1 flex-wrap justify-content-end">
                                    @if (item.CanTransitionTo(BarberShopBooking.Models.AppointmentStatus.Confirmed))
                                    {
                                        <form asp-action="ChangeStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <input type="hidden" name="status" value="Confirmed" />
                                            <button type="submit" class="btn btn-sm btn-success">Xác nhận</button>
                                        </form>
                                    }
                                    @if (item.CanTransitionTo(BarberShopBooking.Models.AppointmentStatus.Completed))
                                    {
                                        <form asp-action="ChangeStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <input type="hidden" name="status" value="Completed" />
                                            <button type="submit" class="btn btn-sm btn-info text-white">Hoàn thành</button>
                                        </form>
                                    }
                                    @if (item.CanTransitionTo(BarberShopBooking.Models.AppointmentStatus.Cancelled))
                                    {
                                        <form asp-action="ChangeStatus" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn hủy lịch hẹn này?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.AppointmentId" />
                                            <input type="hidden" name="status" value="Cancelled" />
                                            <button type="submit" class="btn btn-sm btn-danger">Hủy lịch</button>
                                        </form>
                                    }
                                    @if (!item.CanTransitionTo(BarberShopBooking.Models.AppointmentStatus.Confirmed) &&
                                         !item.CanTransitionTo(BarberShopBooking.Models.AppointmentStatus.Completed) &&
                                         !item.CanTransitionTo(BarberShopBooking.Models.AppointmentStatus.Cancelled))
                                    {
                                        <span class="badge bg-secondary">Hoàn tất</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>