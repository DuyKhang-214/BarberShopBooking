@model BarberShopBooking.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-page">
    <div class="auth-box">
        <h2>Quên mật khẩu</h2>
        <p class="text-center mb-4">Nhập email đã đăng ký, chúng tôi sẽ gửi liên kết để bạn đặt lại mật khẩu.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-action="ForgotPassword" method="post">
            <div class="form-group mb-3">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-icon">
                    <input asp-for="Email" class="form-control" placeholder="Nhập email của bạn" autocomplete="email" />
                    <i class="fa-regular fa-envelope"></i>
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-2">Gửi liên kết đặt lại mật khẩu</button>
        </form>

        <div class="auth-link mt-4 text-center">
            <a asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}