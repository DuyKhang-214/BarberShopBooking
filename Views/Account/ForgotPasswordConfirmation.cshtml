@{
    ViewData["Title"] = "Đã gửi yêu cầu";
    var devLink = TempData["DevResetLink"] as string;
}

<section class="auth-page">
    <div class="auth-box text-center">
        <h2>Kiểm tra email của bạn</h2>
        <p class="mt-3">
            Nếu email đã đăng ký trong hệ thống, bạn sẽ nhận được một liên kết đặt lại mật khẩu.
            Liên kết có hiệu lực trong 30 phút.
        </p>

        @if (!string.IsNullOrEmpty(devLink))
        {
            <div class="alert alert-warning text-start mt-3" role="alert">
                <strong>[Chỉ hiện ở môi trường Development]</strong><br />
                <a href="@devLink">Bấm vào đây để đặt lại mật khẩu</a>
            </div>
        }

        <div class="auth-link mt-4">
            <a asp-controller="Account" asp-action="Login">Quay lại đăng nhập</a>
        </div>
    </div>
</section>