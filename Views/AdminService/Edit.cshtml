@model BarberShopBooking.Models.Service

@{
    ViewData["Title"] = "Chỉnh sửa Dịch vụ";
}

<section class="admin-page py-4">
    <div class="container" style="max-width: 600px;">
        <div class="card bg-dark text-white border-warning p-4 shadow">
            <h2 class="text-warning mb-4"><i class="fa-solid fa-pen-to-square me-2"></i> Chỉnh sửa Dịch vụ</h2>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ServiceId" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="form-group mb-3">
                    <label asp-for="ServiceName" class="form-label">Tên dịch vụ *</label>
                    <input asp-for="ServiceName" class="form-control bg-dark text-white border-secondary" required />
                    <span asp-validation-for="ServiceName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="form-label">Giá dịch vụ (VNĐ) *</label>
                    <input asp-for="Price" type="number" step="1000" min="1000" class="form-control bg-dark text-white border-secondary" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DurationMinutes" class="form-label">Thời lượng thực hiện (Phút) *</label>
                    <input asp-for="DurationMinutes" type="number" min="15" step="15" class="form-control bg-dark text-white border-secondary" required />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="isFeatured">
                    <label class="form-check-label" for="isFeatured">Dịch vụ Nổi bật</label>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IsActive" class="form-label">Trạng thái hoạt động</label>
                    <select asp-for="IsActive" class="form-select bg-dark text-white border-secondary">
                        <option value="true">Đang hoạt động</option>
                        <option value="false">Tạm ngưng</option>
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Thay đổi ảnh dịch vụ</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="@Model.ServiceName" class="rounded" style="height: 80px; object-fit: cover;" />
                        </div>
                    }
                    <input type="file" name="imageFile" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
