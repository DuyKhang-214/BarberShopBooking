@model BarberShopBooking.Models.Service

@{
    ViewData["Title"] = "Thêm Dịch vụ mới";
}

<section class="admin-page py-4">
    <div class="container" style="max-width: 600px;">
        <div class="card bg-dark text-white border-warning p-4 shadow">
            <h2 class="text-warning mb-4"><i class="fa-solid fa-plus me-2"></i> Thêm Dịch vụ cắt tóc mới</h2>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label asp-for="ServiceName" class="form-label">Tên dịch vụ *</label>
                    <input asp-for="ServiceName" class="form-control bg-dark text-white border-secondary" placeholder="Nhập tên dịch vụ" required />
                    <span asp-validation-for="ServiceName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Price" class="form-label">Giá dịch vụ (VNĐ) *</label>
                    <input asp-for="Price" type="number" step="1000" min="1000" class="form-control bg-dark text-white border-secondary" required />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="DurationMinutes" class="form-label">Thời lượng thực hiện (Phút) *</label>
                    <input asp-for="DurationMinutes" type="number" min="15" step="15" class="form-control bg-dark text-white border-secondary" value="30" required />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Mô tả các bước thực hiện dịch vụ..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" asp-for="IsFeatured" id="isFeatured">
                    <label class="form-check-label" for="isFeatured">Hiển thị làm Dịch vụ Nổi bật trang chủ</label>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Hình ảnh đại diện dịch vụ</label>
                    <input type="file" name="imageFile" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">Lưu dịch vụ</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
