@model BarberShopBooking.Models.Barber

@{
    ViewData["Title"] = "Thêm Barber mới";
}

<section class="admin-page py-4">
    <div class="container" style="max-width: 600px;">
        <div class="card bg-dark text-white border-warning p-4 shadow">
            <h2 class="text-warning mb-4"><i class="fa-solid fa-user-plus me-2"></i> Thêm Barber mới</h2>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label asp-for="FullName" class="form-label">Họ và tên *</label>
                    <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" placeholder="Nhập họ và tên barber" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Phone" class="form-label">Số điện thoại</label>
                    <input asp-for="Phone" class="form-control bg-dark text-white border-secondary" placeholder="Nhập số điện thoại" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="ExperienceYears" class="form-label">Số năm kinh nghiệm</label>
                    <input asp-for="ExperienceYears" type="number" min="0" class="form-control bg-dark text-white border-secondary" value="3" />
                    <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SkillDescription" class="form-label">Mô tả kỹ năng / Sở trường</label>
                    <textarea asp-for="SkillDescription" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Ví dụ: Chuyên Fade, Undercut, Uốn xoăn..."></textarea>
                    <span asp-validation-for="SkillDescription" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Ảnh chân dung (.jpg, .png, .webp)</label>
                    <input type="file" name="imageFile" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">Lưu Barber</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
