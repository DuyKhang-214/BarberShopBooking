@model List<BarberShopBooking.Models.Barber>

@{
    ViewData["Title"] = "Quản lý Barber";
}

<section class="admin-page py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h1 class="text-warning h3 mb-0"><i class="fa-solid fa-user-tie me-2"></i> Quản lý Thợ Cắt Tóc (Barber)</h1>
            <a asp-action="Create" class="btn btn-warning">
                <i class="fa-solid fa-plus me-1"></i> Thêm Barber mới
            </a>
        </div>

        <div class="table-responsive bg-dark rounded p-3 border border-secondary">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Kinh nghiệm</th>
                        <th>Kỹ năng / Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var barber in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(barber.ImageUrl) ? "/images/barbers/default-barber.jpg" : barber.ImageUrl)"
                                     alt="@barber.FullName" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" />
                            </td>
                            <td class="fw-bold text-warning">@barber.FullName</td>
                            <td>@(string.IsNullOrEmpty(barber.Phone) ? "-" : barber.Phone)</td>
                            <td><span class="badge bg-secondary">@barber.ExperienceYears năm</span></td>
                            <td><small class="text-muted">@(string.IsNullOrEmpty(barber.SkillDescription) ? "-" : barber.SkillDescription)</small></td>
                            <td>
                                @if (barber.IsActive)
                                {
                                    <span class="badge bg-success">Đang làm việc</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Tạm ngưng</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Schedule" asp-route-id="@barber.BarberId" class="btn btn-sm btn-outline-info" title="Lịch làm việc tuần">
                                        <i class="fa-solid fa-calendar-days"></i> Lịch làm
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@barber.BarberId" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@barber.BarberId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn chuyển trạng thái/xóa Barber này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa/Khóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>