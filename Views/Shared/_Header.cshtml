@using System.Security.Claims

<header class="header">
    <div class="container header-wrapper d-flex align-items-center justify-content-between">

        <div class="logo">
            <a asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-scissors text-warning me-1"></i> KD - BARBER
            </a>
        </div>

        <button class="hamburger-btn d-lg-none" id="hamburgerBtn" aria-label="Toggle navigation menu" aria-expanded="false" type="button">
            <i class="fa-solid fa-bars"></i>
        </button>

        <nav class="main-nav" id="mainNav">
            <ul class="menu">
                <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a asp-controller="Admin" asp-action="Index" class="text-warning font-weight-bold">
                            <i class="fa-solid fa-gear me-1"></i> Quản trị Admin
                        </a>
                    </li>
                }

                <li><a asp-controller="Service" asp-action="Index">Dịch vụ</a></li>
                <li><a asp-controller="Hairstyle" asp-action="Index">Kiểu tóc nổi bật</a></li>
                <li><a asp-controller="Appointment" asp-action="Create" class="btn-book-nav">Đặt lịch ngay</a></li>
                <li><a asp-controller="Review" asp-action="PublicReviews">Đánh giá</a></li>
                <li><a asp-controller="Contact" asp-action="Index">Liên hệ</a></li>
            </ul>
        </nav>

        <div class="account-menu">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login" class="login-btn">
                    <i class="fa-solid fa-user me-1"></i> Đăng nhập
                </a>
            }
            else
            {
                var displayName = User.FindFirst(ClaimTypes.GivenName)?.Value ?? User.Identity.Name;
                <div class="user-dropdown position-relative" id="userDropdown">
                    <button class="user-name-btn border-0 bg-transparent text-white" id="userDropdownBtn" aria-expanded="false" type="button">
                        <i class="fa-regular fa-circle-user text-warning me-1"></i> @displayName
                        <i class="fa-solid fa-chevron-down ms-1 small"></i>
                    </button>

                    <div class="dropdown-menu-custom" id="userDropdownMenu">
                        <a asp-controller="Account" asp-action="Profile">
                            <i class="fa-regular fa-user me-2"></i> Hồ sơ cá nhân
                        </a>
                        <a asp-controller="Appointment" asp-action="MyAppointments">
                            <i class="fa-solid fa-clock-rotate-left me-2"></i> Lịch sử đặt lịch
                        </a>
                        <a asp-controller="Account" asp-action="ChangePassword">
                            <i class="fa-solid fa-key me-2"></i> Đổi mật khẩu
                        </a>
                        <hr class="dropdown-divider bg-secondary my-1" />
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent px-3 py-2 w-100 text-start">
                                <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

    </div>
</header>