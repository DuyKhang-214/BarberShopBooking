@model List<BarberShopBooking.Models.Hairstyle>

@{
    ViewData["Title"] = "Quản lý Bộ sưu tập Kiểu tóc";
}

<section class="admin-page py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <h1 class="text-warning h3 mb-0"><i class="fa-solid fa-images me-2"></i> Quản lý Bộ sưu tập Kiểu tóc</h1>
            <a asp-action="Create" class="btn btn-warning">
                <i class="fa-solid fa-plus me-1"></i> Thêm Kiểu tóc mới
            </a>
        </div>

        <div class="table-responsive bg-dark rounded p-3 border border-secondary">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên kiểu tóc</th>
                        <th>Danh mục</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(h.ImageUrl) ? "/images/hairstyles/default-hairstyle.jpg" : h.ImageUrl)"
                                     alt="@h.HairstyleName" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                            </td>
                            <td class="fw-bold text-warning">@h.HairstyleName</td>
                            <td><span class="badge bg-secondary">@h.Category</span></td>
                            <td><small class="text-muted">@h.Description</small></td>
                            <td>
                                @if (h.IsActive)
                                {
                                    <span class="badge bg-success">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã ẩn</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Edit" asp-route-id="@h.HairstyleId" class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                        <i class="fa-solid fa-pen-to-square"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@h.HairstyleId" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa kiểu tóc này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>