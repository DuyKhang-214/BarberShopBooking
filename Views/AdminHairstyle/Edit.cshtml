@model BarberShopBooking.Models.Hairstyle

@{
    ViewData["Title"] = "Chỉnh sửa Kiểu tóc";
}

<section class="admin-page py-4">
    <div class="container" style="max-width: 600px;">
        <div class="card bg-dark text-white border-warning p-4 shadow">
            <h2 class="text-warning mb-4"><i class="fa-solid fa-pen-to-square me-2"></i> Chỉnh sửa Kiểu tóc</h2>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="HairstyleId" />
                <input type="hidden" asp-for="ImageUrl" />

                <div class="form-group mb-3">
                    <label asp-for="HairstyleName" class="form-label">Tên kiểu tóc *</label>
                    <input asp-for="HairstyleName" class="form-control bg-dark text-white border-secondary" required />
                    <span asp-validation-for="HairstyleName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Category" class="form-label">Danh mục phong cách</label>
                    <select asp-for="Category" class="form-select bg-dark text-white border-secondary">
                        <option value="Lịch Lãm">Lịch Lãm</option>
                        <option value="Năng Động">Năng Động</option>
                        <option value="Thời Trang">Thời Trang</option>
                        <option value="Cổ Điển">Cổ Điển</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="form-label">Mô tả ngắn</label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="IsActive" class="form-label">Trạng thái hiển thị</label>
                    <select asp-for="IsActive" class="form-select bg-dark text-white border-secondary">
                        <option value="true">Hiển thị</option>
                        <option value="false">Ẩn</option>
                    </select>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label">Thay đổi ảnh minh họa</label>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mb-2">
                            <img src="@Model.ImageUrl" alt="@Model.HairstyleName" class="rounded" style="height: 100px; object-fit: cover;" />
                        </div>
                    }
                    <input type="file" name="imageFile" class="form-control bg-dark text-white border-secondary" accept="image/*" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning px-4">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
